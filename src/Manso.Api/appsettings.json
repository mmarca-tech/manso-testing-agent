{
  "ConnectionStrings": {
    "RunStore": "Host=localhost;Port=5432;Database=testing_agent_gateway;Username=postgres;Password=postgres"
  },
  "RunIntakeAuthentication": {
    "BearerToken": "local-dev-token"
  },
  "Jira": {
    "BaseUrl": "https://your-tenant.atlassian.net",
    "CloudId": "replace-me",
    "UserEmail": "your.name@example.com",
    "ApiToken": "replace-me"
  },
  "Confluence": {
    "BaseUrl": "https://your-tenant.atlassian.net/wiki",
    "UserEmail": "your.name@example.com",
    "ApiToken": "replace-me",
    "AllowedHosts": [
      "yourcompany.atlassian.net"
    ]
  },
  "JiraRetrieval": {
    "IncludeComments": true,
    "MaxComments": 10
  },
  "DocumentationRetrieval": {
    "IncludeCommentLinks": false,
    "MaxPages": 5,
    "MaxChunksPerPage": 3,
    "RequireDocumentation": false
  },
  "Xray": {
    "BaseUrl": "https://xray.cloud.getxray.app/api/v2/",
    "ClientId": "replace-me",
    "ClientSecret": "replace-me"
  },
  "XrayRetrieval": {
    "Enabled": false,
    "MaxNeighboringTests": 5,
    "ProjectKey": "",
    "EnableScenarioAutoUpsert": false,
    "DefaultCreatedTestType": "Cucumber",
    "SearchJqlTemplate": "project = {XRAY_PROJECT_KEY} AND issuetype = Test AND (text ~ \"\\\"{ISSUE_KEY}\\\"\" OR text ~ \"\\\"{ISSUE_SUMMARY}\\\"\") ORDER BY updated DESC"
  },
  "RepositoryRetrieval": {
    "MaxChangedFiles": 25,
    "MaxDiffLinesPerFile": 80,
    "MaxNeighboringTests": 5,
    "MaxNeighboringTestLines": 120
  },
  "GenerationContext": {
    "MaxChangedFileExcerpts": 8,
    "MaxNeighboringTests": 5,
    "MaxComments": 5
  },
  "ScenarioGeneration": {
    "MinScenarios": 1,
    "MaxScenarios": 8
  },
  "Validation": {
    "PlaceholderMarkers": [
      "TODO",
      "FIXME",
      "TBD",
      "{{",
      "}}",
      "<placeholder>"
    ],
    "AllowedFileExtensions": [
      ".cs",
      ".feature",
      ".json",
      ".yml",
      ".yaml",
      ".xml",
      ".md",
      ".txt",
      ".js",
      ".jsx",
      ".ts",
      ".tsx"
    ],
    "RequireAssertionsInGeneratedTests": true
  },
  "Llm": {
    "Provider": "Disabled",
    "ApiKey": "replace-me",
    "Model": "replace-me",
    "BaseUrl": "",
    "MaxOutputTokens": 4000,
    "Temperature": 0.2
  },
  "Scm": {
    "Provider": "AzureDevOps",
    "BaseUrl": "https://dev.azure.com/your-org",
    "Organization": "your-org",
    "ReadToken": "replace-me",
    "WriteToken": "replace-me"
  },
  "RepoAdapters": {
    "Repositories": {
      "bank-otp-api": {
        "Provider": "AzureDevOps",
        "Organization": "afs-dev",
        "Project": "rps",
        "RepositoryName": "bank-otp-api",
        "RepositoryUrl": "https://dev.azure.com/afs-dev/rps/_git/bank-otp-api",
        "DefaultBranch": "main",
        "SupportsExecutableTestGeneration": false,
        "TestFramework": "xUnit",
        "TargetFramework": ".NET 10",
        "TestFileSuffix": "Tests.cs",
        "TestDirectoryRoots": [
          "/tests",
          "/src/Tests"
        ],
        "AllowedHelperDirectoryRoots": [
          "/tests",
          "/src/Tests"
        ],
        "ProtectedPathPrefixes": [
          "/src",
          "/infra",
          "/docs"
        ],
        "BuildCommands": [
          "dotnet build src/Manso.sln"
        ],
        "TestCommands": [
          "dotnet test src/Manso.sln"
        ],
        "FormatterCommands": [
          "dotnet format src/Manso.sln --verify-no-changes"
        ]
      }
    }
  },
  "RunPersistence": {
    "Provider": "Postgres",
    "AutoInitializeSchema": true
  },
  "RequestNormalization": {
    "AllowedConfluenceHosts": [
      "yourcompany.atlassian.net"
    ],
    "DefaultGenerationMode": "TestCasesOnly",
    "DefaultWorkflowPass": "ScenarioDesign",
    "DefaultTestScope": "Api",
    "DefaultCoverageIntent": "Regression",
    "DefaultOutputTarget": "JiraComment"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
