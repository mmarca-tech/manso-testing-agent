{
  "ConnectionStrings": {
    "RunStore": "Host=localhost;Port=5432;Database=testing_agent_gateway;Username=postgres;Password=postgres"
  },
  "RunIntakeAuthentication": {
    "BearerToken": "local-dev-token"
  },
  "Jira": {
    "BaseUrl": "https://your-tenant.atlassian.net",
    "CloudId": "replace-me",
    "UserEmail": "your.name@domain.com",
    "ApiToken": "replace-me"
  },
  "Confluence": {
    "BaseUrl": "https://your-tenant.atlassian.net/wiki",
    "UserEmail": "your.name@domain.com",
    "ApiToken": "replace-me",
    "AllowedHosts": [
      "yourcompany.atlassian.net"
    ]
  },
  "JiraRetrieval": {
    "IncludeComments": true,
    "MaxComments": 10
  },
  "DocumentationRetrieval": {
    "IncludeCommentLinks": false,
    "MaxPages": 5,
    "MaxChunksPerPage": 3,
    "RequireDocumentation": false
  },
  "Xray": {
    "BaseUrl": "https://xray.cloud.getxray.app/api/v2/",
    "ClientId": "replace-me",
    "ClientSecret": "replace-me"
  },
  "XrayRetrieval": {
    "Enabled": false,
    "MaxNeighboringTests": 5,
    "EnableScenarioAutoUpsert": false,
    "DefaultCreatedTestType": "Cucumber"
  },
  "RepositoryRetrieval": {
    "MaxChangedFiles": 25,
    "MaxDiffLinesPerFile": 80,
    "MaxNeighboringTests": 5,
    "MaxNeighboringTestLines": 120
  },
  "GenerationContext": {
    "MaxChangedFileExcerpts": 8,
    "MaxNeighboringTests": 5,
    "MaxComments": 5
  },
  "ScenarioGeneration": {
    "MinScenarios": 1,
    "MaxScenarios": 8
  },
  "Validation": {
    "PlaceholderMarkers": [
      "TODO",
      "FIXME",
      "TBD",
      "{{",
      "}}",
      "<placeholder>"
    ],
    "AllowedFileExtensions": [
      ".cs",
      ".feature",
      ".json",
      ".yml",
      ".yaml",
      ".xml",
      ".md",
      ".txt",
      ".js",
      ".jsx",
      ".ts",
      ".tsx"
    ],
    "RequireAssertionsInGeneratedTests": true
  },
  "Llm": {
    "Provider": "Disabled",
    "ApiKey": "replace-me",
    "Model": "replace-me",
    "BaseUrl": "",
    "MaxOutputTokens": 4000,
    "RequestTimeoutSeconds": 300,
    "Temperature": 0.2
  },
  "Scm": {
    "Provider": "AzureDevOps",
    "BaseUrl": "https://dev.azure.com/your-org",
    "Organization": "your-org",
    "ReadToken": "replace-me",
    "WriteToken": "replace-me"
  },
  "RunPersistence": {
    "Provider": "Postgres",
    "AutoInitializeSchema": true
  },
  "RequestNormalization": {
    "AllowedConfluenceHosts": [
      "yourcompany.atlassian.net"
    ],
    "DefaultGenerationMode": "TestCasesOnly",
    "DefaultWorkflowPass": "ScenarioDesign",
    "DefaultTestScope": "Api",
    "DefaultCoverageIntent": "Regression",
    "DefaultOutputTarget": "JiraComment"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
