# First-party Jira REST integration. Preferred for CI/Kubernetes because it
# avoids running any third-party MCP server for Jira data extraction.
JIRA_URL=https://your-site.atlassian.net
JIRA_USERNAME=service-account@example.com
JIRA_API_TOKEN=

# Optional. Used to build Jira issue ARIs for Atlassian GraphQL developmentInformation.
# If omitted, the extractor tries to discover it from /_edge/tenant_info.
JIRA_CLOUD_ID=

# Optional. Defaults to true.
# Set false to skip Confluence REST hydration in extract-ticket.
# summarize-confluence-impact exits without output when this is false.
CONFLUENCE_ENABLED=true

# Optional. Defaults to JIRA_URL + /wiki and the same username/token when CONFLUENCE_ENABLED=true.
CONFLUENCE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_USERNAME=service-account@example.com
CONFLUENCE_API_TOKEN=

# Optional LLM workflow steps: summarize linked pull request changes, review active
# pull requests, review linked Xray tests, generate release notes, and generate/update
# Xray tests. LLM_PROVIDER supports openai and anthropic. OpenAI remains the default
# and still accepts OPENAI_API_KEY / OPENAI_MODEL for backward compatibility.
# In Azure DevOps PR pipelines, SYSTEM_ACCESSTOKEN can be used instead of
# AZURE_DEVOPS_PAT when scripts are allowed to access the OAuth token.
AZURE_DEVOPS_PAT=
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5.5
LLM_BASE_URL=
# Optional. Anthropic direct defaults to claude-sonnet-4-6, API version 2023-06-01,
# and max output 16000. Provider-specific fallbacks are also supported.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_MAX_OUTPUT_TOKENS=16000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=

# Optional implementation agent overrides for implement-xray-tests.
# LLM_PROVIDER selects the SDK runner: openai uses @openai/codex-sdk,
# anthropic uses @anthropic-ai/claude-agent-sdk. AGENT_PATH overrides the
# provider executable. AGENT_ARGUMENTS is only for explicit shell commands.
MANSO_TEST_IMPLEMENTATION_AGENT_PATH=
MANSO_TEST_IMPLEMENTATION_AGENT_ARGUMENTS=
MANSO_TEST_IMPLEMENTATION_COMMAND=
MANSO_TEST_VERIFY_COMMAND=

# Optional durable filesystem memory. Point this at the manso-memory-cabin Git
# repository URL to clone/reuse it from any target repo. Local paths still work
# for development. Generated JSON/Markdown outputs and Juana's editable persona
# live in that clone.
MANSO_MEMORY_ROOT=https://your-git-host/your-org/manso-memory-cabin.git
MANSO_MEMORY_ENABLED=true
# Optional local clone cache. Defaults to ~/.manso/memory-cabins.
MANSO_MEMORY_CACHE_DIR=
# Optional branch to clone/checkout when MANSO_MEMORY_ROOT is a Git URL.
MANSO_MEMORY_BRANCH=
# Optional. When true, a memory write failure fails the workflow instead of
# logging a warning and continuing.
MANSO_MEMORY_STRICT=false

# Optional LLM observability. OTEL_PROVIDER supports phoenix and langfuse.
# When enabled, workflow spans and OpenAI/Anthropic OpenInference spans are sent
# to the selected OpenTelemetry backend for per-task token and cost tracking.
OTEL_PROVIDER=phoenix
OTEL_ENABLED=false
OTEL_PROJECT_NAME=manso-testing-agent
# Phoenix local default: http://localhost:6006
# Langfuse local compose default: http://localhost:3000
# Langfuse Cloud examples: https://cloud.langfuse.com or https://us.cloud.langfuse.com
OTEL_ENDPOINT=http://localhost:6006
# Phoenix bearer token, when required.
OTEL_API_KEY=
# Langfuse Basic auth keys, when OTEL_PROVIDER=langfuse.
# The local compose stack bootstraps pk-lf-local / sk-lf-local by default.
OTEL_PUBLIC_KEY=
OTEL_SECRET_KEY=
# Optional shared session override. Leave empty to auto-group by Jira issue or PR.
OTEL_SESSION_ID=
# Optional user fallback. Azure DevOps BUILD_REQUESTEDFOREMAIL wins when present.
OTEL_USER_ID=
OTEL_BATCH=true
# Optional. For Codex internal OTel traces beyond the workflow cost span, either
# provide a Codex SDK config JSON object directly or forward the selected backend.
MANSO_CODEX_SDK_CONFIG=
MANSO_CODEX_FORWARD_OTEL=false
# Optional content redaction for traces. Set true if prompts/responses must not
# be stored in traces; token/cost attributes still come from provider usage.
OPENINFERENCE_HIDE_INPUTS=false
OPENINFERENCE_HIDE_OUTPUTS=false

# Optional next workflow step: generate/update Xray tests and create a Test Set.
# Use the data residency URL for your Xray Cloud tenant when needed.
# XRAY_TEST_LINK_TYPE is a Jira issue link type lookup hint; links are sent by resolved id.
XRAY_BASE_URL=https://xray.cloud.getxray.app
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_TEST_LINK_TYPE=tests
XRAY_TEST_LINK_DIRECTION=test-to-ticket
