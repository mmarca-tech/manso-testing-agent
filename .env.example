# Manso environment contract.
# Copy to .env and fill in the values you need. JIRA_*, CONFLUENCE_*, XRAY_*,
# and Azure variables use each tool's conventional names; Manso-specific settings
# use the MANSO_* prefix.

# --- Jira REST (Context Layer backbone; preferred for headless CI) ----------
JIRA_URL=https://your-site.atlassian.net
JIRA_USERNAME=service-account@example.com
JIRA_API_TOKEN=

# Optional. Jira cloud id, used to build issue ARIs for the Atlassian GraphQL
# developmentInformation query. Auto-discovered from /_edge/tenant_info if omitted.
JIRA_CLOUD_ID=

# --- Confluence REST (optional context source) ------------------------------
# Defaults to JIRA_URL + /wiki and the same username/token when enabled.
CONFLUENCE_ENABLED=true
CONFLUENCE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_USERNAME=service-account@example.com
CONFLUENCE_API_TOKEN=

# --- LLM provider (test design phase) ---------------------------------------
# LLM_PROVIDER supports openai and anthropic. For Azure OpenAI, set
# LLM_BASE_URL to your /openai/v1 endpoint; Manso auto-detects Azure and
# uses Chat Completions instead of the Responses API (override with
# LLM_API_STYLE=responses|chat-completions).
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# LLM_API_STYLE=                       # responses | chat-completions (auto)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=

# --- LLM provider OVERRIDE (implementation phase, optional) -----------------
# When set, the agent (Codex / Claude Agent SDK) uses these instead of the
# design LLM above. Useful when design + implementation need different
# providers — e.g. Azure GPT for design + Anthropic Claude for implement.
# Unset = fall back to the design LLM.
IMPLEMENTATION_LLM_PROVIDER=
IMPLEMENTATION_LLM_API_KEY=
IMPLEMENTATION_LLM_MODEL=
IMPLEMENTATION_LLM_BASE_URL=

# --- Xray Cloud (test management sink) --------------------------------------
XRAY_BASE_URL=https://xray.cloud.getxray.app
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
# OPTIONAL — defaults to "is tested by" in code (the resolver matches it against
# your Jira link types and picks the direction so the STORY shows that
# relationship). Only set these to override for a Jira instance that differs.
# XRAY_TEST_LINK_TYPE=is tested by
# XRAY_TEST_LINK_DIRECTION=test-to-ticket

# --- VCS (branches, pull requests, comments) --------------------------------
# Manso auto-detects the repo's remote and uses the matching adapter.
# The token authenticates BOTH the REST API (PR create, comments) AND the
# `git push` (via http.extraHeader) — so unattended/pipeline runs need no
# pre-configured git credentials. When no token is set, the push falls back to
# the host's local git credentials (credential helper / SSH key).
#
# Azure DevOps: PAT with Code (Read & Write) + Pull Request (Read & Write). In
# ADO pipelines, SYSTEM_ACCESSTOKEN may be used instead.
AZURE_DEVOPS_PAT=
# GitHub (github.com or Enterprise): token with `contents:write` (push) and
# `pull_requests:write` (PR + comments). GH_TOKEN is also accepted.
GITHUB_TOKEN=

# --- Optional cross-repository Memory Cabin ---------------------------------
# Supplemental history/context only; .agents/memory remains authoritative.
# A root alone never enables it. See docs/MEMORY-CABIN.md for permissions,
# redaction limits, retention, strict failures and curated knowledge.
MANSO_MEMORY_ENABLED=false
MANSO_MEMORY_ROOT=
MANSO_MEMORY_BRANCH=main
MANSO_MEMORY_CACHE_DIR=
MANSO_MEMORY_STRICT=false
MANSO_MEMORY_READ_CONTEXT=true

# --- Implementation agent overrides (optional) ------------------------------
# LLM_PROVIDER selects the SDK runner: anthropic uses @anthropic-ai/claude-agent-sdk,
# openai uses @openai/codex-sdk.
MANSO_IMPLEMENTATION_AGENT_PATH=
MANSO_IMPLEMENTATION_AGENT_ARGUMENTS=
MANSO_IMPLEMENTATION_COMMAND=
# Sandbox profile for the code agent: danger-full-access (default, most
# permissive) | workspace-write | read-only. Dial down for shared/CI runs.
MANSO_SANDBOX=danger-full-access
# Optional Codex SDK config JSON and telemetry forwarding.
MANSO_CODEX_SDK_CONFIG=
MANSO_CODEX_FORWARD_OTEL=false

# Optional local repository mapping for test-step reuse and self-updates.
MANSO_REPO_ROOTS=
MANSO_AGENT_REPO=

# Optional audit/cost output paths and custom model pricing JSON.
MANSO_AUDIT_LOG=
MANSO_COST_LEDGER=
MANSO_MODEL_PRICES=

# --- Observability (optional) -----------------------------------------------
# Traces every LLM call (tokens, latency, prompt/output) and each agent run,
# grouped into a session per Jira issue. Supports two backends via OTEL_PROVIDER:
# "phoenix" (self-hosted Arize Phoenix) or "langfuse" (cloud or self-hosted).
OTEL_ENABLED=false
OTEL_PROVIDER=phoenix
OTEL_PROJECT_NAME=manso

# Phoenix: point OTEL_ENDPOINT at your Phoenix collector; OTEL_API_KEY if secured.
# OTEL_PROVIDER=phoenix
OTEL_ENDPOINT=http://localhost:6006
OTEL_API_KEY=

# Langfuse: set OTEL_PROVIDER=langfuse and supply the project keys below. Leave
# OTEL_ENDPOINT BLANK to default to Langfuse Cloud (https://cloud.langfuse.com);
# for EU/US/self-hosted set it to that base URL (the /api/public/otel/v1/traces
# path is appended automatically). Get the keys from Langfuse → Project Settings.
# OTEL_PROVIDER=langfuse
# OTEL_ENDPOINT=https://cloud.langfuse.com
OTEL_PUBLIC_KEY=
OTEL_SECRET_KEY=

# Batch spans (default true). Set false to export synchronously while debugging.
OTEL_BATCH=true

# Optional content redaction for traces (hide prompts/outputs from the backend).
OPENINFERENCE_HIDE_INPUTS=false
OPENINFERENCE_HIDE_OUTPUTS=false
