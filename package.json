{
  "name": "manso-testing-agent",
  "version": "2.5.1",
  "description": "Bounded Jira, PR, Confluence, and Xray test workflow CLI and TypeScript library.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": ""
  },
  "bin": {
    "review-pull-request": "./dist/reviewPullRequestCli.js",
    "generate-release-notes": "./dist/generateReleaseNotesCli.js",
    "generate-xray-tests": "./dist/xrayTestGenerationCli.js",
    "implement-xray-tests": "./dist/xrayTestImplementationCli.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "scripts/run-ticket-workflow.ps1"
  ],
  "keywords": [
    "jira",
    "xray",
    "qa",
    "test-generation",
    "azure-devops",
    "confluence"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run",
    "publish:azure": "npm publish --userconfig .azure/.npmrc",
    "publish-confluence-docs": "tsx scripts/publish-confluence-docs.ts",
    "test": "vitest run",
    "review-pull-request": "tsx src/reviewPullRequestCli.ts",
    "generate-release-notes": "tsx src/generateReleaseNotesCli.ts",
    "generate-xray-tests": "tsx src/xrayTestGenerationCli.ts",
    "implement-xray-tests": "tsx src/xrayTestImplementationCli.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@anthropic-ai/sdk": "^0.95.1",
    "@arizeai/openinference-instrumentation-anthropic": "^0.1.10",
    "@arizeai/openinference-instrumentation-openai": "^4.1.0",
    "@arizeai/phoenix-otel": "^1.0.1",
    "@openai/codex": "^0.130.0",
    "@openai/codex-sdk": "^0.130.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.205.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "dotenv": "^17.4.2",
    "openai": "^6.37.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "marked": "^18.0.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
