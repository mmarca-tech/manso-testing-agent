{
  "name": "@mmarca-tech/manso-testing-agent",
  "version": "0.1.0",
  "description": "Manso - an end-to-end AI testing agent: context-aware test design and multi-stack test automation.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmarca-tech/manso-testing-agent.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "manso": "./dist/cli/main.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    ".env.example",
    "docs/MEMORY-CABIN.md"
  ],
  "keywords": [
    "testing",
    "qa",
    "test-generation",
    "bdd",
    "gherkin",
    "jira",
    "xray"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run",
    "release:plan": "node scripts/release.mjs plan",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "docker:build": "docker build -t manso:local .",
    "manso": "tsx src/cli/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@anthropic-ai/sdk": "^0.95.1",
    "@arizeai/openinference-instrumentation-anthropic": "^0.1.10",
    "@arizeai/openinference-instrumentation-openai": "^4.1.0",
    "@arizeai/phoenix-otel": "^1.0.1",
    "@openai/codex-sdk": "^0.130.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.205.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "openai": "^6.37.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
